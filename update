#!/bin/bash
# Put this on $PATH as `update`. It sets up an environment the Python CLI can
# count on, then gets out of the way.
set -euo pipefail

# Even dirname and readlink below need somewhere to be found; a caller can
# hand us a PATH without them.
PATH="${PATH:-}:/usr/bin:/bin:/usr/sbin:/sbin"

# Follow symlinks: this is normally reached through one in ~/.local/bin, and
# the project lives where the real file is. Without this, uv runs outside the
# project and re-runs whatever `update` it finds on PATH — this symlink.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  link_dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$link_dir/$source"
done
SCRIPT_DIR="$(cd -P "$(dirname "$source")" && pwd)"

# launchd hands a job PATH=/usr/bin:/bin:/usr/sbin:/sbin, where none of the
# package managers can be found, so build the PATH here rather than trusting
# the caller's. Anything not installed is simply not added.
for prefix in /opt/homebrew /usr/local /opt/local; do
  [ -d "$prefix/bin" ] && PATH="$prefix/bin:$prefix/sbin:$PATH"
done
PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
# pnpm refuses to do anything unless its own global bin directory is on PATH,
# and it is a login shell that normally puts it there.
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
export PATH

if ! command -v uv &>/dev/null; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "update: 'uv' not found and no terminal to ask on. See https://astral.sh/uv" >&2
    exit 1
  fi
  if command -v brew &>/dev/null; then
    prompt="update needs 'uv' (a Python version/dependency manager) — install it with Homebrew? [y/N] "
  else
    prompt="update needs 'uv' (a Python version/dependency manager) — download and run the installer from astral.sh? [y/N] "
  fi
  read -r -p "$prompt" ans
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    echo "Install uv manually: https://astral.sh/uv" >&2
    exit 1
  fi
  if command -v brew &>/dev/null; then
    brew install uv
  else
    curl -LsSf https://astral.sh/uv/install.sh | sh
    PATH="$HOME/.local/bin:$PATH"
  fi
  command -v uv &>/dev/null || { echo "update: uv still not on PATH after install." >&2; exit 1; }
fi

# --frozen keeps uv from re-resolving; it does not make this offline, since a
# first run still downloads Python and the locked dependencies into the cache.
# --no-dev keeps the test dependencies out of an ordinary user's environment.
exec uv run --frozen --no-dev --project "$SCRIPT_DIR" update "$@"
